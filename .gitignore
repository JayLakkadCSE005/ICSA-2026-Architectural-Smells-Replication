*.jps

# Jupyter checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Node (if any)
node_modules/

# Python virtual envs
venv/
.env/
.venv/

# Build outputs (keep results Excel files)
*.tmp

# Office lock files
~$*

# Planning & Submission directories (local only, excluded from GitHub)
.planning/
submission/
